{
  "expo": {
    "name": "RE:TR4CKS",
    "slug": "retracks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.yskms.retracks",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.yskms.retracks",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppleMusicUsageDescription": "端末内の音楽を表示・再生するために、メディアライブラリへのアクセスを使用します。",
        "NSPhotoLibraryUsageDescription": "端末内の音楽に関連するアートワークを表示するために、写真ライブラリへのアクセスを使用します。",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      "./plugins/with-ios-app-delegate-fix",
      "expo-music-library",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-router",
      "expo-image",
      "expo-localization",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "NowPlayingWidget",
              "displayName": "RE:TR4CKS",
              "description": "今再生中の曲を表示します",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ]
    ],
    "scheme": "retracks",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59342ca5-7e2a-4f59-ba6b-d70810756568"
      }
    }
  }
}
