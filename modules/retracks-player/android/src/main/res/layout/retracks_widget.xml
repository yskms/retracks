<?xml version="1.0" encoding="utf-8"?>
<!--
  ホーム画面のウィジェット。
  左にジャケット、右に曲情報と操作ボタンを置く。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/retracks_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/retracks_widget_background"
    android:padding="10dp"
    android:gravity="center_vertical">

  <!--
    幅を wrap_content にして adjustViewBounds を効かせることで、
    高さに合わせて幅が決まる。横に広げてもジャケットが伸びない。

    maxWidth で頭打ちにしているのは、縦に大きくしたときに幅も比例して広がり、
    右側の曲情報と操作ボタンを押し出してしまうため。
  -->
  <ImageView
      android:id="@+id/retracks_widget_artwork"
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:maxWidth="160dp"
      android:adjustViewBounds="true"
      android:scaleType="fitCenter"
      android:contentDescription="@string/retracks_widget_artwork_description"
      android:src="@drawable/retracks_artwork_placeholder" />

  <!-- 曲情報と操作ボタン。最低限の幅を確保して潰れないようにする -->
  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:minWidth="150dp"
      android:orientation="vertical"
      android:paddingStart="12dp"
      android:paddingEnd="4dp">

    <TextView
        android:id="@+id/retracks_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#F2F2F5"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="@string/retracks_widget_idle_title" />

    <TextView
        android:id="@+id/retracks_widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#9A9AA8"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:text="@string/retracks_widget_idle_artist" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

      <ImageButton
          android:id="@+id/retracks_widget_prev"
          android:layout_width="0dp"
          android:layout_height="40dp"
          android:layout_weight="1"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:src="@drawable/retracks_ic_prev"
          android:contentDescription="@string/retracks_widget_prev_description" />

      <ImageButton
          android:id="@+id/retracks_widget_toggle"
          android:layout_width="0dp"
          android:layout_height="40dp"
          android:layout_weight="1"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:src="@drawable/retracks_ic_play"
          android:contentDescription="@string/retracks_widget_toggle_description" />

      <ImageButton
          android:id="@+id/retracks_widget_next"
          android:layout_width="0dp"
          android:layout_height="40dp"
          android:layout_weight="1"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:src="@drawable/retracks_ic_next"
          android:contentDescription="@string/retracks_widget_next_description" />

      <ImageButton
          android:id="@+id/retracks_widget_replay"
          android:layout_width="0dp"
          android:layout_height="40dp"
          android:layout_weight="1"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:src="@drawable/retracks_ic_replay"
          android:contentDescription="@string/retracks_widget_replay_description" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
