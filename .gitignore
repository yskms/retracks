# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# 補足: /ios /android は Expo prebuild で生成されるため追跡しない。
# ネイティブ拡張が必要になった場合も、patch-package もしくは
# ローカル Expo モジュール（modules/）で対応する方針（docs/requirements.md 13.3）。
